// CollabBoard — Prisma schema
// Auth.js (NextAuth v5) models + application models.
// Docs: https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth.js models ────────────────────────────────────────────────────────

model User {
  id               String               @id @default(cuid())
  name             String?
  email            String               @unique
  emailVerified    DateTime?
  image            String?
  accounts         Account[]
  sessions         Session[]
  boards           Board[]
  createdBoards    Board[]              @relation("BoardCreator")
  orgMemberships   OrganizationMember[]
  boardMemberships BoardMember[]
  comments         Comment[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ──────────────────────────────────────────────────────

// Membership role inside an organization. An org ADMIN administers every board
// in the org; a MEMBER can edit them.
enum OrgRole {
  ADMIN
  MEMBER
}

// Per-board membership role. Precedence over org-level roles — an explicit
// board grant is more specific than an org-wide one.
enum BoardMemberRole {
  ADMIN
  EDITOR
  COMMENTER
  VIEWER
}

model Organization {
  id                String               @id @default(cuid())
  name              String
  // Set for a user's auto-created personal workspace; the unique constraint
  // guarantees at most one personal org per user.
  personalForUserId String?              @unique
  members           OrganizationMember[]
  boards            Board[]
  folders           Folder[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model OrganizationMember {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      OrgRole      @default(MEMBER)
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([userId])
}

model Folder {
  id        String       @id @default(cuid())
  name      String
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  boards    Board[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orgId])
}

// Explicit per-user grant on a single board. Owner (Board.createdById) always
// has admin and is not represented here.
model BoardMember {
  id        String          @id @default(cuid())
  boardId   String
  board     Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      BoardMemberRole @default(VIEWER)
  createdAt DateTime        @default(now())

  @@unique([boardId, userId])
  @@index([userId])
}

model Board {
  id             String         @id @default(cuid())
  title          String         @default("Untitled Board")
  // Legacy owner column — kept in sync with createdById until the running
  // deployments are migrated off it; dropped in a later cleanup migration.
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User           @relation("BoardCreator", fields: [createdById], references: [id], onDelete: Cascade)
  orgId          String
  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folderId       String?
  folder         Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  isPublic       Boolean        @default(false)
  thumbnailUrl   String?
  lastActivityAt DateTime       @default(now())
  archivedAt     DateTime?
  deletedAt      DateTime?
  members        BoardMember[]
  snapshot       BoardSnapshot?
  versions       BoardVersion[]
  comments       Comment[]
  shareLinks     ShareLink[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([createdById])
  @@index([folderId])
  // Hot dashboard query: boards in an org ordered by recency.
  @@index([orgId, updatedAt])
}

// A comment anchored to a point on the canvas, with threaded replies. A root
// comment carries x/y page coordinates and no parent; a reply carries a parentId
// and no coordinates (it inherits the root's anchor).
model Comment {
  id        String    @id @default(cuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  x         Float?
  y         Float?
  resolved  Boolean   @default(false)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
  @@index([parentId])
}

// Append-only version history for a board's canvas. Distinct from the single-row
// BoardSnapshot backstop (latest-state-only): each row is a named checkpoint the
// user can restore to. yjsState is a full Yjs binary state, captured on demand.
model BoardVersion {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  yjsState    Bytes
  label       String?
  // Who saved this checkpoint; nullable so a version outlives the user's row.
  createdById String?
  createdAt   DateTime @default(now())

  @@index([boardId, createdAt])
}

// Role granted to a visitor. The board owner (Board.userId) always has full
// control and is not represented here.
enum ShareRole {
  VIEWER
  EDITOR
}

// Unguessable, revocable, optionally-expiring capability link to a board. Replaces
// the permanent guessable board-cuid URL as the secure sharing primitive; the
// legacy `Board.isPublic` flag still grants read-only access on its own.
model ShareLink {
  id          String    @id @default(cuid())
  token       String    @unique
  boardId     String
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  role        ShareRole @default(VIEWER)
  createdById String
  expiresAt   DateTime?
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([boardId])
}

// Durable backstop for a board's canvas. The live canvas lives only in the
// Liveblocks room (Yjs); this persists the latest Yjs binary state to Postgres
// so a room eviction or vendor outage can no longer lose a board. One latest
// snapshot per board (upserted); append-style version history is a later phase.
model BoardSnapshot {
  id        String   @id @default(cuid())
  boardId   String   @unique
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  yjsState  Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
